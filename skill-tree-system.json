  "progressionRules": {
    "experienceGain": {
      "stoneAge": "Gain XP from basic tool use, fire creation, and primitive crafting",
      "bronzeAge": "Gain XP from pottery, early metalworking, and livestock domestication",
      "ironAge": "Gain XP from advanced metallurgy, agriculture, and masonry",
      "industrialAge": "Gain XP from mechanical engineering, chemistry, and electrical work",
      "informationAge": "Gain XP from computer programming, biotechnology, and advanced systems",
      "harvesting": "Gain XP when gathering resources, bonus for rare materials",
      "combat": "Gain XP from winning fights and taming bandits",
      "exploration": "Gain XP from discovering new areas and mapping terrain",
      "social": "Gain XP from successful breeding, leadership, and diplomacy"
    },
    "crossSkillUnlocks": {
      "metalworking": "Requires fire making + clay working + mining",
      "ironworking": "Requires metalworking + advanced kiln technology",
      "electronics": "Requires electricity + precision manufacturing",
      "computerScience": "Requires electronics + advanced mathematical knowledge",
      "biotechnology": "Requires chemistry + selective breeding mastery",
      "mechanicalEngineering": "Requires precision smithing + steel mastery",
      "banditTaming": "Requires combat tactics + charismatic leadership"
    },
    "historicalProgression": {
      "description": "Skills follow Earth's technological development timeline",
      "ageProgression": "Animals naturally progress from Stone Age → Bronze → Iron → Industrial → Information",
      "prerequisiteChains": "Advanced technologies require mastery of earlier foundation skills",
      "individualProgress": "Each animal develops skills independently - no shared technology unlocks"
    },
    "advancedPathRequirements": {
      "description": "Advanced paths require maxing base skill + meeting specific prerequisites",
      "multiplePathsAllowed": true,
      "pathInteractions": "Advanced paths can enable other advanced paths across skill trees",
      "gameplayImpact": "All advanced skills provide concrete gameplay benefits that affect world interaction"
    }
  }
}
