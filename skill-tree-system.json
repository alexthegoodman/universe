{
  "skillTrees": {
    "stoneAge": {
      "name": "Stone Age Technologies",
      "skills": {
        "stoneKnapping": {
          "name": "Stone Knapping",
          "maxLevel": 100,
          "description": "Shape stone into basic tools and weapons",
          "advancedPaths": [
            {
              "name": "Flint Mastery",
              "requirements": ["stoneKnapping: 100", "traitAnalysis: 40"],
              "description": "Create exceptionally sharp and durable stone tools",
              "effects": ["Stone tools cut like metal", "+50% tool durability"]
            },
            {
              "name": "Composite Tools",
              "requirements": ["stoneKnapping: 100", "cordage: 60"],
              "description": "Combine stone with wood and binding",
              "effects": [
                "Create hafted axes and spears",
                "Tools don't break on use"
              ]
            }
          ]
        },
        "firemaking": {
          "name": "Fire Making",
          "maxLevel": 100,
          "description": "Create and control fire for cooking and warmth",
          "advancedPaths": [
            {
              "name": "Controlled Burning",
              "requirements": ["firemaking: 100", "foraging: 50"],
              "description": "Use fire to manage landscape and hunting",
              "effects": [
                "Clear land for resources",
                "Drive livestock for hunting"
              ]
            },
            {
              "name": "Kiln Technology",
              "requirements": ["firemaking: 100", "clayWorking: 75"],
              "description": "Build high-temperature furnaces",
              "effects": [
                "Enable pottery and metalworking",
                "Reach 1200°C temperatures"
              ]
            }
          ]
        },
        "cordage": {
          "name": "Cordage & Weaving",
          "maxLevel": 100,
          "description": "Create rope, nets, and woven materials",
          "prerequisites": ["foraging: 25"],
          "advancedPaths": [
            {
              "name": "Advanced Textiles",
              "requirements": ["cordage: 100", "livestockHusbandry: 50"],
              "description": "Create complex woven fabrics",
              "effects": ["Produce clothing and sails", "Weather protection"]
            },
            {
              "name": "Engineering Cables",
              "requirements": ["cordage: 100", "metalworking: 40"],
              "description": "Create strong cables for construction",
              "effects": ["Build suspension bridges", "Heavy lifting systems"]
            }
          ]
        }
      }
    },
